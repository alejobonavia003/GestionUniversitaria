<!DOCTYPE html>
<html>
<head>
    <title>Planes de Estudio</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-4">
        <h1>Planes de Estudio</h1>
        <a href="/planes/nuevo" class="btn btn-primary mb-3">Nuevo Plan de Estudio</a>
        
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Carrera</th>
                    <th>Año del Plan</th>
                    <th>Versión</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody> 
                {{#planes}}
                <tr>
                    <td>{{id}}</td>
                    <td>{{cod_carrera}}</td>
                    <td>{{anio_plan}}</td>
                    <td>{{version}}</td>
                    <td>
                        <a href="/planes/{{id}}/editar" class="btn btn-sm btn-info">Editar</a>
                        <form action="/planes/{{id}}" method="POST" style="display: inline;">
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Estás seguro?')">Eliminar</button>
                        </form>
                    </td>
                </tr>
                {{/planes}}
            </tbody>
        </table>
    </div>
    
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>