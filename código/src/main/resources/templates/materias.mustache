<!DOCTYPE html>
<html>
<head>
    <title>Materias</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-4">
        <h1>Materias</h1>
        <a href="/materias/nueva" class="btn btn-primary mb-3">Nueva Materia</a>
        
        <table class="table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Correlativas</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody> 
                {{#materias}}
                <tr>
                    <td>{{codigo_materia}}</td>
                    <td>{{nombre}}</td>
                    <td>
                        {{#correlativas}}
                            <span class="badge badge-info">{{.}}</span>
                        {{/correlativas}}
                    </td>
                    <td>
                        <a href="/materias/{{codigo_materia}}/editar" class="btn btn-sm btn-info">Editar</a>
                        <form action="/materias/{{codigo_materia}}" method="POST" style="display: inline;">
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Estás seguro?')">Eliminar</button>
                        </form>
                    </td>
                </tr>
                {{/materias}}
            </tbody>
        </table>
    </div>
    
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>