{{< layout/base }}
{{$title}}Lista de Carreras{{/title}}

{{$content}}
<div class="container">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1 class="h2">Lista de Carreras</h1>
            <a href="/carreras/nueva" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nueva Carrera
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Nombre</th>
                                    <th>Duración (años)</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#carreras}}
                                <tr>
                                    <td>{{cod_carrera}}</td>
                                    <td>{{nombre}}</td>
                                    <td>{{duracion}}</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="/carreras/{{cod_carrera}}/editar" class="btn btn-sm btn-info">
                                                <i class="fas fa-edit"></i> Editar
                                            </a>
                                            <form action="/carreras/{{cod_carrera}}" method="POST" class="d-inline">
                                                <input type="hidden" name="_method" value="DELETE">
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Estás seguro de eliminar esta carrera?')">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            </form>
                                            <a href="/planes?carrera={{cod_carrera}}" class="btn btn-sm btn-secondary">
                                                <i class="fas fa-book"></i> Planes
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                {{/carreras}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{/content}}

{{$extraScripts}}
<script>
    $(document).ready(function() {
        $('.nav-link[href="/carreras"]').addClass('active');
    });
</script>
{{/extraScripts}}
{{/ layout/base }}