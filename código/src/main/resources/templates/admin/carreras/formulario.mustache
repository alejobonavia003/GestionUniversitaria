{{> /layout/base}}

{{$title}}Gestión de Carreras{{/title}}
{{$pageTitle}}Gestión de Carreras{{/pageTitle}}

{{$content}}
<div class="container-fluid mt-4">

  <!-- Encabezado y botón "Nueva Carrera" -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0 fw-bold text-dark">Gestión de Carreras</h2>
    <a href="/admin/carreras/nueva" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
      <i class="fas fa-plus me-2"></i> Nueva Carrera
    </a>
  </div>

  <!-- Mensajes de alerta -->
  {{#successMessage}}
  <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
    <div class="d-flex align-items-center">
      <i class="fas fa-check-circle me-2"></i>
      <div>{{successMessage}}</div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  {{/successMessage}}

  {{#errorMessage}}
  <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
    <div class="d-flex align-items-center">
      <i class="fas fa-exclamation-circle me-2"></i>
      <div>{{errorMessage}}</div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  {{/errorMessage}}

  <!-- Tabla de carreras -->
  <div class="card shadow-sm rounded-3 border-0">
    <div class="card-header bg-white border-0 py-3">
      <h5 class="card-title mb-0 fw-semibold">
        <i class="fas fa-list me-2 text-primary"></i>Lista de Carreras
      </h5>
    </div>
    <div class="card-body p-0">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4 fw-semibold text-muted">Código</th>
            <th class="fw-semibold text-muted">Nombre</th>
            <th class="fw-semibold text-muted">Duración (años)</th>
            <th class="text-end pe-4 fw-semibold text-muted">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {{#carreras}}
          <tr>
            <td class="ps-4">
              <span class="badge bg-light text-dark fs-6">{{id}}</span>
            </td>
            <td class="fw-semibold">{{nombre}}</td>
            <td>
              <span class="badge bg-primary rounded-pill">{{duracion}} años</span>
            </td>
            <td class="text-end pe-4">
              <!-- Botón Editar -->
              <a href="/admin/carreras/{{id}}/editar" class="btn btn-sm btn-outline-primary me-2 rounded-pill px-3">
                <i class="fas fa-edit me-1"></i> Editar
              </a>

              <!-- Botón Eliminar -->
              <form action="/admin/carreras/{{id}}/eliminar" method="POST" class="d-inline"
                onsubmit="return confirm('¿Eliminar la carrera {{nombre}}? Esta acción no se puede deshacer.');">
                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                  <i class="fas fa-trash me-1"></i> Eliminar
                </button>
              </form>
            </td>
          </tr>
          {{/carreras}}

          {{^carreras}}
          <tr>
            <td colspan="4" class="text-center text-muted py-5">
              <div class="py-4">
                <i class="fas fa-graduation-cap fa-3x text-light mb-3"></i>
                <h5 class="text-muted">No hay carreras registradas</h5>
                <p class="text-muted mb-3">Comienza agregando la primera carrera al sistema</p>
                <a href="/admin/carreras/nueva" class="btn btn-primary rounded-pill px-4">
                  <i class="fas fa-plus me-1"></i> Agregar nueva carrera
                </a>
              </div>
            </td>
          </tr>
          {{/carreras}}
        </tbody>
      </table>
    </div>
  </div>
</div>
{{/content}}

{{$extraScripts}}
<script>
  $(document).ready(function () {
    $('.sidebar .nav-link[href="/admin/carreras"]').addClass('active');
  });
</script>
{{/extraScripts}}