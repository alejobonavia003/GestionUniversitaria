<!DOCTYPE html>

<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>{{$title}}Sistema de Gestión{{/title}}</title>

<!-- Bootstrap 5 (Links Corregidos) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- FontAwesome para iconos (Link Corregido) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<!-- CSS (Estilos) -->
<style>
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: 250px;
        background-color: #343a40;
        color: white;
        padding-top: 20px;
    }
    .sidebar-header {
        padding: 0 20px;
        margin-bottom: 20px;
        text-align: center;
    }
    .sidebar .nav-link {
        color: #c2c7d0;
        padding: 10px 20px;
    }
    .sidebar .nav-link:hover, .sidebar .nav-link.active {
        background-color: #495057;
        color: #fff;
    }
    .sidebar .nav-link .fas {
        margin-right: 10px;
    }
    .main-content {
        margin-left: 250px;
        padding: 20px;
    }
</style>


</head>
<body class="bg-light">

<div class="d-flex">
    <!-- Incluimos la Sidebar -->
    {{> sidebar}}
    
    <!-- Contenido Principal -->
    <main class="main-content w-100">
        
        <!-- Breadcrumbs -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/dashboard">Inicio</a></li>
                {{#breadcrumbs}}
                <li class="breadcrumb-item {{#active}}active{{/active}}">
                    {{#url}}<a href="{{url}}">{{text}}</a>{{/url}}
                    {{^url}}{{text}}{{/url}}
                </li>
                {{/breadcrumbs}}
            </ol>
        </nav>

        <!-- Título de Página y Botón -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2">{{$pageTitle}}Dashboard{{/pageTitle}}</h1>
            {{#actionButton}}
            <a href="{{url}}" class="btn btn-primary shadow-sm rounded-pill">
                <i class="fas {{icon}} me-1"></i> {{text}}
            </a>
            {{/actionButton}}
        </div>

        <!-- Bloque de Contenido Principal -->
        {{$content}}{{/content}}
        
    </main>
</div>

<!-- Incluimos el Footer (parcial) -->
{{> footer}}

<!-- 
  ¡SOLUCIÓN! El bloque extraScripts DEBE definirse aquí, 
  en el layout base (padre), no en el parcial (footer).
-->
{{$extraScripts}}{{/extraScripts}}


</body>
</html>