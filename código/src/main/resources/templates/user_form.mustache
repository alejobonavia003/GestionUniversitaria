<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Cuenta - Sistema de Gestión</title>
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome para iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .register-container {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            width: 100%;
            max-width: 450px;
        }
        .register-header {
            background: linear-gradient(135deg, #343a40 0%, #495057 100%);
            color: white;
            padding: 2rem;
            text-align: center;
        }
        .register-header h2 {
            margin: 0;
            font-weight: 600;
        }
        .register-header i {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            color: #fff;
        }
        .register-body {
            padding: 2rem;
        }
        .form-control, .form-select {
            border-radius: 50px;
            padding: 12px 20px;
            border: 2px solid #e9ecef;
            transition: all 0.3s ease;
        }
        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        .form-select {
            appearance: none;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
            background-position: right 0.75rem center;
            background-repeat: no-repeat;
            background-size: 16px 12px;
        }
        .btn-register {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            border: none;
            border-radius: 50px;
            padding: 12px;
            font-weight: 600;
            color: white;
            transition: all 0.3s ease;
        }
        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(40, 167, 69, 0.4);
        }
        .login-link {
            color: #667eea;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
        }
        .login-link:hover {
            color: #764ba2;
        }
        .alert {
            border-radius: 10px;
            border: none;
        }
        .alert-danger {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }
        .alert-success {
            background: rgba(25, 135, 84, 0.1);
            color: #198754;
        }
        .form-label {
            font-weight: 600;
            color: #495057;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-header">
            <i class="fas fa-user-plus"></i>
            <h2>Crear Cuenta</h2>
            <p class="mb-0 mt-2 opacity-75">Sistema de Gestión</p>
        </div>
        
        <div class="register-body">
            {{#successMessage}}
                <div class="alert alert-success mb-4" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    {{successMessage}}
                </div>
            {{/successMessage}}

            {{#errorMessage}}
                <div class="alert alert-danger mb-4" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    {{errorMessage}}
                </div>
            {{/errorMessage}}

            <form action="/user/new" method="post">
                <div class="mb-3">
                    <label for="name" class="form-label">
                        <i class="fas fa-user me-2"></i>Nombre de Usuario
                    </label>
                    <input type="text" 
                           class="form-control" 
                           id="name" 
                           name="name" 
                           placeholder="Ingresa tu nombre de usuario"
                           required
                           autocomplete="username">
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">
                        <i class="fas fa-lock me-2"></i>Contraseña
                    </label>
                    <input type="password" 
                           class="form-control" 
                           id="password" 
                           name="password" 
                           placeholder="Crea una contraseña segura"
                           required
                           autocomplete="new-password">
                </div>

                <div class="mb-4">
                    <label for="role" class="form-label">
                        <i class="fas fa-user-tag me-2"></i>Tipo de Usuario
                    </label>
                    <select class="form-select" id="role" name="role" required>
                        <option value="ESTUDIANTE" selected>Alumno (Estudiante)</option>
                        <option value="PROFESOR">Profesor</option>
                        <option value="ADMIN">Administrador</option>
                    </select>
                    <div class="form-text mt-2">
                        <small>
                            <i class="fas fa-info-circle me-1"></i>
                            Selecciona el tipo de cuenta según tu rol en el sistema
                        </small>
                    </div>
                </div>

                <button type="submit" class="btn btn-register w-100 mb-3">
                    <i class="fas fa-user-plus me-2"></i>Registrar Usuario
                </button>
            </form>

            <div class="text-center pt-3 border-top">
                <p class="text-muted mb-2">¿Ya tienes una cuenta?</p>
                <a href="/" class="login-link me-3">
                    <i class="fas fa-sign-in-alt me-1"></i>Iniciar Sesión
                </a>
                <span class="text-muted">|</span>
                <a href="/" class="login-link ms-3">
                    <i class="fas fa-home me-1"></i>Volver al Inicio
                </a>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Script para mejoras de UX -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Agregar foco al primer campo
            const nameInput = document.getElementById('name');
            if (nameInput) {
                nameInput.focus();
            }
            
            // Animación suave para los alerts
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                alert.style.opacity = '0';
                alert.style.transform = 'translateY(-10px)';
                
                setTimeout(() => {
                    alert.style.transition = 'all 0.3s ease';
                    alert.style.opacity = '1';
                    alert.style.transform = 'translateY(0)';
                }, 100);
            });

            // Efecto para el select
            const roleSelect = document.getElementById('role');
            if (roleSelect) {
                roleSelect.addEventListener('focus', function() {
                    this.style.borderColor = '#667eea';
                });
                roleSelect.addEventListener('blur', function() {
                    this.style.borderColor = '#e9ecef';
                });
            }
        });
    </script>
</body>
</html>