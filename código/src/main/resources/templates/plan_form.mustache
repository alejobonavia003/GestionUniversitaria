<!DOCTYPE html>
<html>
<head>
    <title>{{#plan}}Editar{{/plan}}{{^plan}}Nuevo{{/plan}} Plan de Estudio</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-4">
        <h1>{{#plan}}Editar{{/plan}}{{^plan}}Nuevo{{/plan}} Plan de Estudio</h1>
        
        <form action="{{#plan}}/planes/{{id}}{{/plan}}{{^plan}}/planes{{/plan}}" method="POST">
            <div class="form-group">
                <label for="cod_carrera">Carrera:</label>
                <select class="form-control" id="cod_carrera" name="cod_carrera" required>
                    <option value="">Seleccione una carrera...</option>
                    {{#carreras}}
                    <option value="{{cod_carrera}}" {{#plan}}{{#equals cod_carrera}}selected{{/equals}}{{/plan}}>
                        {{nombre}}
                    </option>
                    {{/carreras}}
                </select>
            </div>
             
            <div class="form-group">
                <label for="anio_plan">Año del Plan:</label>
                <input type="number" class="form-control" id="anio_plan" name="anio_plan" 
                       value="{{#plan}}{{anio_plan}}{{/plan}}" required min="2000" max="2100">
            </div>
            
            <div class="form-group">
                <label for="version">Versión:</label>
                <input type="number" class="form-control" id="version" name="version" 
                       value="{{#plan}}{{version}}{{/plan}}" required min="1">
            </div>
            
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a href="/planes" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
    
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>